# ------------------------------------------------------------
# Household Finance Lab — files not committed to GitHub
# ------------------------------------------------------------

# Respondent-level data. Blanket ignore: anything not explicitly
# allowed below stays out. The source file comes from the Federal
# Reserve; derived files are rebuilt locally by code/01_build.do.
# See data/README.md.
*.dta
*.sav
*.csv
*.zip

# Explicitly allowed: aggregate results only.
# No file listed here contains respondent-level data.
!output/*.csv

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Stata
*.tmp
*.gph
*.smcl

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Run logs stay local
logs/
